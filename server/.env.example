# Copy to .env (git-ignored) and fill in real values.
# Get a free key at https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_org_key_here

# ── Toggle Account System (SSO) ──────────────────────────────────────────────
# The central auth service this app signs users in with. Toggle News registers
# itself as the "toggle-news" OAuth client; the redirect URI below must match the
# one registered in the account system (src/common/clients.js) exactly.
AUTH_BASE_URL=http://localhost:4000
TOGGLE_NEWS_CLIENT_ID=toggle-news
TOGGLE_NEWS_APP_ORIGIN=http://localhost:5173
# Optional overrides — defaults derive from APP_ORIGIN / CLIENT_ID:
# TOGGLE_NEWS_REDIRECT_URI=http://localhost:5173/auth/callback
# TOGGLE_NEWS_SCOPES=profile.read offline_access
# TOGGLE_NEWS_TOKEN_AUDIENCE=toggle-news
# TOGGLE_NEWS_TOKEN_ISSUER=https://auth.toggle.local

